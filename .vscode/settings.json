  },
  "lslint.executablePath": "C:\\Users\\devmagb650rtx3060\\Desktop\\.-. merp\\lslint_v1.2.7_win64\\lslint.exe",
  "lslint.path": "C:\\Users\\devmagb650rtx3060\\Desktop\\.-. merp\\lslint_v1.2.7_win64\\lslint.exe",

  // Map .slua files to the Luau language to allow the luau-lsp + SL types to run on sLua files
  "files.associations": {
    "*.slua": "luau"
  },

  // LSL linting integration (requires the "LSLint For VSCode" extension); keep enabled for .lsl files.
  "lslint.enabled": true,

  "vscord.status.idle.timeout": 25000,

  // Enable Luau language server for sLua files and point it at the SL types we install locally
  "luau-lsp.plugin.enabled": true,

  // Language-specific editor settings for LSL files
  "[lsl]": {
    "editor.defaultFormatter": null,
    "editor.folding": true
  },

  // SL type definitions (generated by sl_lua_types). Run the task "Update SL Lua Types" to download into .vscode/sl_lua_types
  "luau-lsp.types.definitionFiles": {
    "sl-slua": "c:\\Users\\devmagb650rtx3060\\Desktop\\.-. merp_sl stuff\\.vscode\\sl-vscode-plugin\\slua_default.d.luau"
  },
  "luau-lsp.types.documentationFiles": [
    "c:\\Users\\devmagb650rtx3060\\Desktop\\.-. merp_sl stuff\\.vscode\\sl-vscode-plugin\\slua_default.docs.json"
  ],
  "luau-lsp.platform.type": "standard",
  "luau-lsp.sourcemap.enabled": false,
  "luau-lsp.sourcemap.includeNonScripts": true
